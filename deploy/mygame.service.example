[Unit]
Description=MYGAME standalone web server
After=network.target

[Service]
Type=simple
User=mygame
Group=mygame
WorkingDirectory=/opt/mygame
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
ExecStart=/usr/bin/node /opt/mygame/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
