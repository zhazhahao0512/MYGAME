{
  "name": "little-expedition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "小队远征：桌面网页界面与流程原型",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "start": "node scripts/server.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "test:shop": "node scripts/shop-interaction-check.mjs",
    "check": "tsc --noEmit && node --check src/app.js && node --check src/model.js && node --check src/battle.js",
    "build": "npm run check && vite build",
    "preview": "node scripts/server.mjs --preview",
    "test:engine": "node scripts/engine-check.mjs",
    "package:deploy": "npm run build && node scripts/package-deploy.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "playwright-core": "1.58.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
